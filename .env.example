# Copy to .env (gitignored) and fill in. Used by `source scripts/env.sh`.
#
# OpenRouter stand-in (works on this Mac, no CUDA):
FSYN_LLM_BASE_URL=https://openrouter.ai/api/v1
FSYN_LLM_MODEL=qwen/qwen-2.5-coder-32b-instruct
FSYN_LLM_API_KEY=sk-or-v1-...
#
# Rented vLLM (product default). SSH-tunnel the pod, then:
# FSYN_LLM_BASE_URL=http://127.0.0.1:8000/v1
# FSYN_LLM_MODEL=wyt2000/CodeV-SVA-14B
# FSYN_LLM_API_KEY=EMPTY
#
# AssertLLM2 checkout (do not vendor into this repo):
# FSYN_ASSERTLLM2_ROOT=$HOME/.cache/formalsynapse/AssertLLM2
